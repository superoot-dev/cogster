{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cogs",
  "scopeName": "source.cogs",
  "fileTypes": ["cogs"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#axis-decl" },
    { "include": "#binding" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.cogs",
      "match": "//.*$"
    },
    "axis-decl": {
      "match": "^\\s*(axis)\\s+([A-Za-z_][A-Za-z0-9_-]*(?:\\s+[A-Za-z_][A-Za-z0-9_-]*)*)\\s*(=)",
      "captures": {
        "1": { "name": "keyword.declaration.axis.cogs" },
        "2": { "name": "entity.name.type.axis.cogs" },
        "3": { "name": "keyword.operator.assignment.cogs" }
      }
    },
    "binding": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*(?:\\s+[A-Za-z_][A-Za-z0-9_-]*)*?)\\s*(=)(?!=)",
      "captures": {
        "1": { "name": "variable.other.binding.cogs" },
        "2": { "name": "keyword.operator.assignment.cogs" }
      }
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#matrix-pipe" },
        { "include": "#keyword" },
        { "include": "#tag" },
        { "include": "#currency" },
        { "include": "#number-unit" },
        { "include": "#number" },
        { "include": "#function-call" },
        { "include": "#operator" }
      ]
    },
    "matrix-pipe": {
      "name": "punctuation.separator.matrix.cogs",
      "match": "\\|"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.aggregate.cogs",
          "match": "\\b(sum|avg|min|max)\\b"
        },
        {
          "name": "keyword.control.cogs",
          "match": "\\b(over|per)\\b"
        }
      ]
    },
    "tag": {
      "patterns": [
        {
          "name": "constant.language.tag.wildcard.cogs",
          "match": ":\\*"
        },
        {
          "name": "entity.name.tag.cogs",
          "match": ":[A-Za-z0-9][A-Za-z0-9_-]*"
        }
      ]
    },
    "currency": {
      "name": "constant.numeric.currency.cogs",
      "match": "\\$[0-9]+(?:\\.[0-9]+)?"
    },
    "number-unit": {
      "match": "\\b([0-9]+(?:\\.[0-9]+)?)\\s+([A-Za-z]+)\\b",
      "captures": {
        "1": { "name": "constant.numeric.cogs" },
        "2": { "name": "support.type.unit.cogs" }
      }
    },
    "number": {
      "name": "constant.numeric.cogs",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.cogs" }
      }
    },
    "operator": {
      "name": "keyword.operator.cogs",
      "match": "[+\\-*/@=]"
    }
  }
}
