// Multi-SKU model — uses axes + tagged values + auto-broadcast.
// Formulas written ONCE; the engine broadcasts/zips over the sku and channel axes.

axis sku = :widget bar :energy bar
axis channel = :fakemart :indie :amazon :shopify

// --- global: ingredient base prices ---
oats price = $42 / 50 lb
almond butter price = $215 / 25 lb
honey price = $120 / 30 lb
dark chocolate price = $175 / 25 lb
sea salt price = $30 / 50 lb
peanut butter price = $180 / 25 lb
oat flour price = $55 / 50 lb

// --- global: taxes (imported ingredients) ---
us food duty pct = 0.02
broker fee pct = 0.0035
import uplift = 1 + us food duty pct + broker fee pct
almond butter landed price = almond butter price * import uplift
peanut butter landed price = peanut butter price * import uplift

// --- global: channel rates ---
fakemart trade pct = 0.10425
fakemart take pct = 0.265
faire fee pct = 0.15
amazon referral pct = 0.15
shopify merchant fee pct = 0.029

// --- per-channel deduction (single-axis inline literal) ---
channel deduction pct = :fakemart fakemart trade pct + fakemart take pct, :indie faire fee pct, :amazon amazon referral pct, :shopify shopify merchant fee pct

// --- per-sku COGS (inline-tagged literal; multi-line continuation in each branch) ---
cogs per bar =
  :widget bar  0.0510 lb * oats price +
               0.01836 lb * almond butter landed price +
               0.01224 lb * honey price +
               0.01545 lb * dark chocolate price +
               0.00202 lb * sea salt price + $0.282
  :energy bar  0.0450 lb * oat flour price +
               0.0200 lb * peanut butter landed price +
               0.0100 lb * honey price +
               0.0100 lb * dark chocolate price +
               0.0020 lb * sea salt price + $0.240

// --- per-(sku, channel) pricing — matrix form ---
price per bar =
  |               | :fakemart | :indie | :amazon | :shopify
  | :widget bar   | $1.55     | $1.65  | $2.50   | $1.69
  | :energy bar   | $1.45     | $1.55  | $2.75   | $1.79

// --- per-(sku, channel) sell-in — matrix form ---
bars per year =
  |               | :fakemart | :indie  | :amazon | :shopify
  | :widget bar   | 3494400   | 1996800 | 180000  | 453600
  | :energy bar   |  748800   |  686400 | 264000  | 129600

// --- amazon fulfillment overhead (broadcast over sku) ---
amazon variable per bar = :amazon $0.405

// --- G2N waterfall: written ONCE, evaluates per (sku, channel) ---
gross sales = price per bar * bars per year
net sales = gross sales * (1 - channel deduction pct)
cogs total = cogs per bar * bars per year
gross profit = net sales - cogs total
gross margin pct = gross profit / gross sales

// --- pivots ---
profit by sku = sum gross profit over :channel
profit by channel = sum gross profit over :sku
total profit = sum gross profit over :sku :channel
total gross = sum gross sales over :sku :channel

// --- corp burn ---
fixed annual = $532240
contribution after fixed = total profit - fixed annual

// --- selectors ---
widget fakemart profit = gross profit :widget bar :fakemart
amazon profit total = sum gross profit :amazon over :sku
